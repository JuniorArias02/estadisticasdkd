# ── Base de datos ──────────────────────────────────
# Formato: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
DATABASE_URL="mysql://root:password@localhost:3306/estadisticasDkd"

# Variables para Docker Compose (MySQL container)
DB_ROOT_PASSWORD="password"
DB_NAME="estadisticasDkd"

# ── JWT ────────────────────────────────────────────
JWT_SECRET="cambia_esto_por_un_secreto_seguro_en_produccion"
JWT_EXPIRATION="4h"
JWT_REFRESH_SECRET="secreto_para_refresh_token_super_seguro"
JWT_REFRESH_EXPIRATION="7d"

# ── Servidor y CORS ────────────────────────────────
FRONTEND_URL="http://localhost:5173"
PORT=3000

# ── Configuración Regional ─────────────────────────
TZ="America/Bogota"

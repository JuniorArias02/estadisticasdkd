# ==================================================
# NestJS + Prisma + TypeScript — .gitignore
# ==================================================

# ── Dependencias ───────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build / Dist ───────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Variables de entorno ───────────────────────────
.env
.env.*
!.env.example
!.env.template

# ── Prisma ─────────────────────────────────────────
# Cliente generado (se regenera con `prisma generate`)
node_modules/.prisma/
# Archivos de migración temporales (NO ignorar prisma/migrations)
prisma/*.db
prisma/*.db-journal

# ── Cobertura y reportes de tests ──────────────────
coverage/
.nyc_output/
*.lcov

# ── Logs ───────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Caché ──────────────────────────────────────────
.npm/
.eslintcache
.cache/
.turbo/

# ── IDEs y editores ────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~w
.DS_Store
Thumbs.db

# ── Docker ─────────────────────────────────────────
# (docker-compose.yml y Dockerfile SÍ se versioanan)

# ── Temporal / OS ──────────────────────────────────
*.tmp
*.temp
*.bak 
*.orig

# ── Agentes y herramientas de IA ───────────────────
# Descomenta la línea siguiente si no quieres versionar configs de agentes
# .agents/
# .claude/
# .cursor/
# .devin/
